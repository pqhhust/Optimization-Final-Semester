import random


class Thesis:
    def __init__(self, ID):
        self.ID = ID
        self.teacher = None
        self.council = 0


class Teacher:
    def __init__(self, ID):
        self.ID = ID
        self.load = 0
        self.thesises = []
        self.council = 0
        self.min_similarity = {}


class Council: 
    def __init__(self, ID):
        self.ID = ID
        self.load = 0
        self.thesises = []
        self. teachers = []


def import_data():
    s = []
    g = []
    N, M, K = map(int, input().split())

    thesises = [Thesis(i + 1) for i in range(N)]
    teachers = [Teacher(i + 1) for i in range(M)]
    councils = [Council(i + 1) for i in range(K)]

    a, b, c, d, e, f = map(int, input().split())

    for _ in range(N):
        s.append(list(map(int, input().split())))

    for _ in range(N):
        g.append(list(map(int, input().split())))

    t = list(map(int, input().split()))

    for i in range(N):
        thesises[i].teacher = teachers[t[i] - 1]
        teachers[t[i] - 1].load += 1
        teachers[t[i] - 1].thesises.append(i + 1)

    for t1 in range(M):
        for t2 in range(t1 + 1, M):
            teacher1 = teachers[t1]
            teacher2 = teachers[t2]
            teacher1.min_similarity[teacher2] = float('inf')
            for i1 in range(len(teacher1.thesises)):
                s1 = teacher1.thesises[i1]
                for i2 in range(len(teacher2.thesises)):
                    s2 = teacher2.thesises[i2]
                    if teacher1.min_similarity[teacher2] > s[s1 - 1][s2 - 1] and s1 != s2 and s[s1 - 1][s2 - 1] > 0:
                        teacher1.min_similarity[teacher2] = s[s1 - 1][s2 - 1]
            teacher2.min_similarity[teacher1] = teacher1.min_similarity[teacher2]

    return thesises, teachers, councils, a, b, c, d, e, f, s, g


class HillClimbingSolver:
    def __init__(self, thesises, teachers, councils, a, b, c, d, e, f, s, g):
        self.N = len(thesises)
        self.thesises = thesises
        self.M = len(teachers)
        self.teachers = teachers
        self.K = len(councils)
        self.councils = councils
        self. a = a
        self.b = b
        self.c = c
        self.d = d
        self.e = e
        self.f = f
        self.s = s
        self.g = g

        self.best_thesis = [0] * self.N
        self.best_teacher = [0] * self.M
        self.best_score = -float('inf')

    def can_teacher_join(self, te_id, council):
        if len(council.teachers) >= self.d:
            return False
        for th in council.thesises:
            if self. g[th.ID - 1][te_id] < self.f:
                return False
            if th.teacher. ID - 1 == te_id: 
                return False
        for te in council.teachers:
            if self.teachers[te_id]. min_similarity. get(te, float('inf')) < self.e:
                return False
        return True

    def can_thesis_join(self, th_id, council):
        if len(council.thesises) >= self.b:
            return False
        for th in council.thesises:
            if self.s[th_id][th.ID - 1] < self.e:
                return False
        for te in council.teachers:
            if te == self.thesises[th_id].teacher:
                return False
            if self.g[th_id][te.ID - 1] < self.f:
                return False
        return True

    def thesis_contribution(self, th_id, council):
        score = 0
        for th in council.thesises:
            if th.ID - 1 != th_id:
                score += self.s[th_id][th.ID - 1]
        for te in council.teachers:
            score += self.g[th_id][te.ID - 1]
        return score

    def teacher_contribution(self, te_id, council):
        return sum(self.g[th. ID - 1][te_id] for th in council.thesises)

    def total_score(self):
        total = 0
        for c in self.councils:
            for i, t1 in enumerate(c.thesises):
                for t2 in c.thesises[i + 1:]:
                    total += self.s[t1.ID - 1][t2.ID - 1]
                for te in c.teachers:
                    total += self.g[t1.ID - 1][te. ID - 1]
        return total

    def save_best(self):
        score = self.total_score()
        if score > self.best_score:
            self.best_score = score
            for i, th in enumerate(self.thesises):
                self.best_thesis[i] = th. council
            for i, te in enumerate(self.teachers):
                self. best_teacher[i] = te.council

    def restore_best(self):
        for c in self.councils:
            c.thesises = []
            c.teachers = []
            c.load = 0
        for i, th in enumerate(self.thesises):
            th.council = self.best_thesis[i]
            if th.council > 0:
                self.councils[th.council - 1]. thesises.append(th)
        for i, te in enumerate(self.teachers):
            te.council = self.best_teacher[i]
            if te. council > 0:
                self.councils[te.council - 1].teachers.append(te)
                self.councils[te.council - 1].load += te.load

    def clear(self):
        for c in self.councils:
            c. thesises = []
            c.teachers = []
            c. load = 0
        for th in self.thesises:
            th.council = 0
        for te in self.teachers:
            te.council = 0

    def greedy_init(self, seed=None):
        """Initialize with greedy construction"""
        if seed is not None:
            random.seed(seed)

        self.clear()

        # Assign teachers (randomized order)
        teacher_order = list(range(self.M))
        if seed is not None:
            random. shuffle(teacher_order)
        else:
            teacher_order. sort(key=lambda j: -self.teachers[j].load)

        for j in teacher_order:
            te = self.teachers[j]
            best_k, best_score = -1, -float('inf')

            for k, c in enumerate(self.councils):
                if not self.can_teacher_join(j, c):
                    continue
                score = self.teacher_contribution(j, c)
                if len(c.teachers) < self.c:
                    score += 10000
                if score > best_score:
                    best_score = score
                    best_k = k

            if best_k >= 0:
                te.council = best_k + 1
                self.councils[best_k].teachers.append(te)
                self.councils[best_k].load += te.load

        # Assign theses (randomized order)
        thesis_order = list(range(self.N))
        if seed is not None: 
            random.shuffle(thesis_order)

        for i in thesis_order:
            th = self.thesises[i]
            best_k, best_score = -1, -float('inf')

            for k, c in enumerate(self.councils):
                if not self.can_thesis_join(i, c):
                    continue
                score = self.thesis_contribution(i, c)
                if len(c.thesises) < self.a:
                    score += 10000
                if score > best_score:
                    best_score = score
                    best_k = k

            if best_k >= 0:
                th. council = best_k + 1
                self.councils[best_k].thesises.append(th)

    def hill_climb_steepest(self):
        """Steepest ascent hill climbing - find best neighbor each iteration"""
        improved = True
        while improved: 
            improved = False
            best_move = None
            best_gain = 0

            # Try all thesis moves
            for i, th in enumerate(self.thesises):
                if th.council == 0:
                    continue
                curr_k = th.council - 1
                curr_c = self.councils[curr_k]

                if len(curr_c.thesises) <= self.a:
                    continue

                curr_score = self.thesis_contribution(i, curr_c)
                curr_c.thesises.remove(th)

                for k, c in enumerate(self.councils):
                    if k == curr_k:
                        continue
                    if self.can_thesis_join(i, c):
                        gain = self.thesis_contribution(i, c) - curr_score
                        if gain > best_gain:
                            best_gain = gain
                            best_move = ('move_thesis', i, k)

                curr_c.thesises.append(th)

            # Try all thesis swaps
            for i in range(self.N):
                t1 = self.thesises[i]
                if t1.council == 0:
                    continue
                k1 = t1.council - 1
                c1 = self.councils[k1]

                for j in range(i + 1, self.N):
                    t2 = self.thesises[j]
                    if t2.council == 0 or t2.council == t1.council:
                        continue
                    k2 = t2.council - 1
                    c2 = self.councils[k2]

                    old_score = self.thesis_contribution(i, c1) + self.thesis_contribution(j, c2)

                    c1.thesises.remove(t1)
                    c2.thesises.remove(t2)

                    if self. can_thesis_join(i, c2) and self.can_thesis_join(j, c1):
                        new_score = self.thesis_contribution(i, c2) + self.thesis_contribution(j, c1)
                        gain = new_score - old_score
                        if gain > best_gain:
                            best_gain = gain
                            best_move = ('swap_thesis', i, j)

                    c1.thesises.append(t1)
                    c2.thesises.append(t2)

            # Try all teacher moves
            for j, te in enumerate(self.teachers):
                if te.council == 0:
                    continue
                curr_k = te.council - 1
                curr_c = self.councils[curr_k]

                if len(curr_c. teachers) <= self.c:
                    continue

                curr_score = self.teacher_contribution(j, curr_c)
                curr_c.teachers.remove(te)
                curr_c.load -= te.load

                for k, c in enumerate(self.councils):
                    if k == curr_k:
                        continue
                    if self.can_teacher_join(j, c):
                        gain = self.teacher_contribution(j, c) - curr_score
                        if gain > best_gain:
                            best_gain = gain
                            best_move = ('move_teacher', j, k)

                curr_c. teachers.append(te)
                curr_c.load += te. load

            # Try all teacher swaps
            for i in range(self.M):
                te1 = self.teachers[i]
                if te1.council == 0:
                    continue
                k1 = te1.council - 1
                c1 = self.councils[k1]

                for j in range(i + 1, self. M):
                    te2 = self.teachers[j]
                    if te2.council == 0 or te2.council == te1.council:
                        continue
                    k2 = te2.council - 1
                    c2 = self.councils[k2]

                    old_score = self.teacher_contribution(i, c1) + self.teacher_contribution(j, c2)

                    c1.teachers.remove(te1)
                    c1.load -= te1.load
                    c2.teachers.remove(te2)
                    c2.load -= te2.load

                    if self.can_teacher_join(i, c2) and self.can_teacher_join(j, c1):
                        new_score = self. teacher_contribution(i, c2) + self.teacher_contribution(j, c1)
                        gain = new_score - old_score
                        if gain > best_gain:
                            best_gain = gain
                            best_move = ('swap_teacher', i, j)

                    c1.teachers.append(te1)
                    c1.load += te1.load
                    c2.teachers.append(te2)
                    c2.load += te2.load

            # Apply best move
            if best_move:
                improved = True
                if best_move[0] == 'move_thesis':
                    _, i, k = best_move
                    th = self.thesises[i]
                    self.councils[th.council - 1].thesises.remove(th)
                    th.council = k + 1
                    self.councils[k]. thesises.append(th)

                elif best_move[0] == 'swap_thesis':
                    _, i, j = best_move
                    t1, t2 = self.thesises[i], self.thesises[j]
                    c1, c2 = self. councils[t1.council - 1], self.councils[t2.council - 1]
                    c1.thesises. remove(t1)
                    c2.thesises.remove(t2)
                    t1.council, t2.council = c2.ID, c1.ID
                    c2.thesises.append(t1)
                    c1.thesises.append(t2)

                elif best_move[0] == 'move_teacher':
                    _, j, k = best_move
                    te = self.teachers[j]
                    curr_c = self.councils[te.council - 1]
                    curr_c.teachers.remove(te)
                    curr_c. load -= te.load
                    te.council = k + 1
                    self.councils[k].teachers.append(te)
                    self. councils[k].load += te. load

                elif best_move[0] == 'swap_teacher':
                    _, i, j = best_move
                    te1, te2 = self. teachers[i], self.teachers[j]
                    c1, c2 = self.councils[te1.council - 1], self.councils[te2.council - 1]
                    c1.teachers.remove(te1)
                    c1.load -= te1.load
                    c2.teachers.remove(te2)
                    c2.load -= te2.load
                    te1.council, te2.council = c2.ID, c1.ID
                    c2.teachers.append(te1)
                    c2.load += te1.load
                    c1.teachers.append(te2)
                    c1.load += te2.load

    def hill_climb_first_improvement(self):
        """First improvement hill climbing - faster, take first improving move"""
        improved = True
        while improved:
            improved = False

            # Try thesis moves
            for i, th in enumerate(self.thesises):
                if improved:
                    break
                if th.council == 0:
                    continue
                curr_k = th.council - 1
                curr_c = self.councils[curr_k]

                if len(curr_c.thesises) <= self.a:
                    continue

                curr_score = self.thesis_contribution(i, curr_c)
                curr_c.thesises.remove(th)

                for k, c in enumerate(self.councils):
                    if k == curr_k:
                        continue
                    if self.can_thesis_join(i, c):
                        if self.thesis_contribution(i, c) > curr_score:
                            th.council = k + 1
                            c.thesises.append(th)
                            improved = True
                            break

                if not improved:
                    curr_c.thesises.append(th)

            # Try thesis swaps
            for i in range(self.N):
                if improved:
                    break
                t1 = self.thesises[i]
                if t1.council == 0:
                    continue

                for j in range(i + 1, self.N):
                    t2 = self.thesises[j]
                    if t2.council == 0 or t2.council == t1.council:
                        continue

                    c1, c2 = self. councils[t1.council - 1], self.councils[t2.council - 1]
                    old_score = self.thesis_contribution(i, c1) + self.thesis_contribution(j, c2)

                    c1.thesises.remove(t1)
                    c2.thesises.remove(t2)

                    if self. can_thesis_join(i, c2) and self.can_thesis_join(j, c1):
                        new_score = self.thesis_contribution(i, c2) + self.thesis_contribution(j, c1)
                        if new_score > old_score:
                            t1.council, t2.council = c2.ID, c1.ID
                            c2.thesises.append(t1)
                            c1.thesises.append(t2)
                            improved = True
                            break

                    c1.thesises.append(t1)
                    c2.thesises.append(t2)

            # Try teacher moves
            for j, te in enumerate(self.teachers):
                if improved:
                    break
                if te.council == 0:
                    continue
                curr_k = te.council - 1
                curr_c = self.councils[curr_k]

                if len(curr_c.teachers) <= self.c:
                    continue

                curr_score = self.teacher_contribution(j, curr_c)
                curr_c.teachers.remove(te)
                curr_c.load -= te.load

                for k, c in enumerate(self.councils):
                    if k == curr_k:
                        continue
                    if self.can_teacher_join(j, c):
                        if self.teacher_contribution(j, c) > curr_score:
                            te.council = k + 1
                            c.teachers.append(te)
                            c.load += te.load
                            improved = True
                            break

                if not improved:
                    curr_c.teachers.append(te)
                    curr_c.load += te.load

    def solve(self):
        """Multi-start hill climbing"""
        # Determine number of restarts based on problem size
        if self. N <= 20:
            num_restarts = 15
            use_steepest = True
        elif self.N <= 100:
            num_restarts = 10
            use_steepest = True
        else:
            num_restarts = 8
            use_steepest = False  # Use faster first-improvement for large problems

        # First restart:  deterministic greedy
        self.greedy_init(seed=None)
        if use_steepest:
            self.hill_climb_steepest()
        else:
            self.hill_climb_first_improvement()
        self.save_best()

        # Additional restarts with randomization
        for restart in range(1, num_restarts):
            self.greedy_init(seed=restart * 42)
            if use_steepest:
                self.hill_climb_steepest()
            else:
                self.hill_climb_first_improvement()
            self.save_best()

        self.restore_best()

    def print_sol(self):
        print(self.N)
        print(" ".join(str(th.council) for th in self.thesises))
        print(self.M)
        print(" ".join(str(te.council) for te in self.teachers))


def main():
    thesises, teachers, councils, a, b, c, d, e, f, s, g = import_data()
    solver = HillClimbingSolver(thesises, teachers, councils, a, b, c, d, e, f, s, g)
    solver.solve()
    solver.print_sol()


if __name__ == "__main__":
    main()
